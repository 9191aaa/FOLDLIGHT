tide_objective_labels = Array[String](["完成三次十二枚大返光", "连续净化三处墨痕", "高速移动中收纳五枚花瓣", "保持五次返光击杀链", "护住纸舟并触发留白", "连续完成三类精通目标"])
objective_ids = Array[StringName]([&"mastery", &"cleanse", &"mastery", &"mastery", &"escort", &"mastery"])
