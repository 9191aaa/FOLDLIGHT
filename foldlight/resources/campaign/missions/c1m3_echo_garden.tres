boss_id = &"petal_mother"
boss_title = "百瓣灯母"
boss_subtitle = "剥开灯巢，让庭心短暂显露"
opening_title = "花庭记得上一支船队"
opening_body = "每一朵花都在重复同一段未完成的返航。收下它们时，整座庭院会从纸背面呼吸。"
