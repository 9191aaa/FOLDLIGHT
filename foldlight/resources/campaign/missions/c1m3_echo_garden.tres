tide_objective_labels = Array[String](["净化第一株回声花", "接住并送回复唱弹幕", "连续净化两处墨蕊", "守住中央灯", "完成三轮十二枚返光", "洗净花庭核心"])
objective_ids = Array[StringName]([&"cleanse", &"return_quota", &"cleanse", &"beacon_charge", &"mastery", &"cleanse"])
