boss_title = "四秒井"
boss_subtitle = "井里追上来的，都是你刚走过的路"
opening_title = "岑的回响铺成了一条航线"
opening_body = "这里每隔四秒就会出现一次岑。无数个未能返航的瞬间叠在一起，终于变成可走的路。"
