tide_objective_labels = Array[String](["稳定第一枚名字锚", "连续充能镜面航标", "保持五次返光击杀链", "让两枚名字同时发光", "截住逃逸的名字载体", "稳定四枚名字锚点"])
objective_ids = Array[StringName]([&"beacon_charge", &"beacon_charge", &"mastery", &"beacon_charge", &"pursuit", &"beacon_charge"])
