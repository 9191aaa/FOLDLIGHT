subtitle = "连续的返光会让名字重新稳定"
location = "镜海锚地"
synopsis = "四枚名字锚点漂在镜海。保持返光连锁，让港口居民被墨月抹掉的名字重新落回岸上。"
expected_seconds = 540
tide_duration = 75.0
boss_budget_seconds = 90
difficulty = 1.34
