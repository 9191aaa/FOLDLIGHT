boss_id = &"mirror_crown"
boss_title = "回忆冠"
boss_subtitle = "它会把你最近四秒的路线戴在头上"
opening_title = "名字不是标签，是归岸的坐标"
opening_body = "每稳定一枚锚点，远处港口就有人想起自己该如何被呼唤。"
ending_title = "港口重新拥有声音"
ending_body = "人们喊出彼此的名字。那些声音沿镜面一路追上你的纸灯，成为下一片返光。"
