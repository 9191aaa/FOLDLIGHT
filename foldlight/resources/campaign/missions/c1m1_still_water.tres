boss_title = "初灯潮使"
boss_subtitle = "把第一次整轮返光留给它"
opening_title = "纸海没有太阳了"
opening_body = "墨月吞走沿岸的名字，只剩未寄出的灯火漂在潮里。你不用躲开它们——把它们收好，再送回去。"
