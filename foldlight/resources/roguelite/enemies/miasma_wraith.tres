[ext_resource type="Script" path="res://scripts/roguelite/resources/rogue_enemy_definition.gd" id="1"]

[resource]
script = ExtResource("1")
content_id = &"miasma_wraith"
title = "瘴纸游魂"
description = "疾行的残页沿途遗留长效瘴气，击破游魂也不会清除已经留下的毒雾。"
accent = Color(0.663, 0.710, 0.549, 1)
tags = Array[StringName]([&"mechanic", &"poison", &"late_game"])
role = 5
threat_cost = 4
minimum_region = 3
max_simultaneous = 3
base_health = 10.0
move_speed = 270.0
attack_interval = 2.2
stationary = false
quota_group = &"ordinary"
mechanic_rule = "瘴气预告 0.85 秒后持续 60 秒，每 1.6 秒伤 1 格；游魂死亡后仍会滞留。"
counterplay = "优先击破游魂，阻止新毒雾；已经留下的苔绿区域要绕行，等外圈计时耗尽。"
