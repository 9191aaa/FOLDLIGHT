[layer_names]

2d_physics/layer_1="Player"
2d_physics/layer_2="Enemy"
2d_physics/layer_3="World"
2d_physics/layer_4="FriendlyProjectile"
2d_physics/layer_5="HostileProjectile"
2d_physics/layer_6="Trigger"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.012, 0.019, 0.055, 1)
