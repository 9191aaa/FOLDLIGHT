; FOLDLIGHT / 折光
; A complete one-hand narrative bullet-folding campaign for Godot 4.6

config_version=5

[application]

config/name="FOLDLIGHT · 折光"
config/name.pixel_demo="FOLDLIGHT · 像素战斗 Demo"
config/description="一只手或手柄即可游玩的三章弹幕折返战役。"
config/version="3.9.0"
config/icon="res://assets/branding/foldlight_icon_512.png"
run/main_scene="res://scenes/main.tscn"
run/main_scene.pixel_demo="res://scenes/demos/pixel_playable_demo.tscn"
config/features=PackedStringArray("4.6")
boot_splash/bg_color=Color(0.012, 0.019, 0.055, 1)
boot_splash/show_image=false

[autoload]

ProfileManager="*res://scripts/autoloads/profile_manager.gd"
PlatformBridge="*res://scripts/autoloads/platform_bridge.gd"
AudioDirector="*res://scripts/audio_director.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/viewport_width.pixel_demo=1254
window/size/viewport_height.pixel_demo=705
window/size/window_width_override.pixel_demo=1254
window/size/window_height_override.pixel_demo=705
window/size/mode=0
window/size/resizable=true
window/size/resizable.pixel_demo=false
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode.pixel_demo="integer"

