{
  "name": "foldlight-room-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 5188 --inspector-port 0 --persist-to .wrangler/state",
    "db:local": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:api": "node tests/race-api.mjs",
    "bundle:local": "wrangler deploy --dry-run --outdir build/worker"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "typescript": "5.9.3",
    "wrangler": "4.92.0"
  }
}
